{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skulptur Contact Performance Take",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "durationMs", "frames"],
  "properties": {
    "schemaVersion": { "const": "skulptur.contact-performance-take/v0.1" },
    "durationMs": { "type": "number", "minimum": 0 },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "./contact-gesture.schema.json" }
    }
  }
}
