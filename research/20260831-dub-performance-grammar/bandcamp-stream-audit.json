  "reproduction_source": "\"\"\"Audit two public Bandcamp streams; no listening or event attribution.\"\"\"\nimport hashlib, html, json, pathlib, re, subprocess\nimport numpy as np\nfrom analyze_previews import decode\nfrom calibrate_analyzer import SR, frame_rms, onset_times, rms_dbfs\n\npage = pathlib.Path('bandcamp-page.html')\ndata = json.loads(html.unescape(re.search(r'data-tralbum=\"([^\"]+)', page.read_text())[1]))\ncalibration = json.loads(subprocess.check_output(['python', 'calibrate_analyzer.py']))\nassert calibration['all_passed']\nreport = {\n    'date_utc': '2026-09-07',\n    'source_page': 'https://pressuresounds.bandcamp.com/album/the-sound-doctor',\n    'page_sha256': hashlib.sha256(page.read_bytes()).hexdigest(),\n    'scope': 'Shazam retained; Bandcamp added; Spotify not used',\n    'audio_class': 'public player mp3-128, not purchased lossless masters',\n    'pair_status': 'title-based candidate; shared performance and time alignment unverified',\n    'calibration': calibration,\n    'shared_analyzer_blobs': {'calibrate_analyzer.py': '314db6380f63c12017b52dcd3dd2dfcaff94a539', 'analyze_previews.py': '4e36a19c5760cc1f3a7cf4b80ad3e9ad6e3baa47'},\n    'limits': ['Signal measurements, not listening.', 'No stem separation or CUT/THROW attribution.', 'Thirty-second windows are independent and unaligned across tracks.', 'RMS uses stereo arithmetic mean, so phase cancellation can affect values.', 'Partial final windows and fades must not be treated as matched musical sections.', 'Synthetic calibration does not validate musical interpretation.'],\n    'tracks': [],\n}\nfor track in data['trackinfo']:\n    if track['title'] not in ('Smiling Faces', 'Smiling version'):\n        continue\n    path = pathlib.Path(str(track['track_id']) + '.mp3')\n    audio = decode(path)\n    probe = json.loads(subprocess.check_output(['ffprobe', '-v', 'error', '-show_format', '-show_streams', '-of', 'json', str(path)]))\n    windows = []\n    for start in range(0, len(audio), 30 * SR):\n        clip = audio[start:start + 30 * SR]\n        levels = 20 * np.log10(np.maximum(frame_rms(clip), 1e-15))\n        windows.append({'start_s': start / SR, 'end_s': (start + len(clip)) / SR, 'rms_dbfs': rms_dbfs(clip), 'frame_rms_dbfs_p10_p50_p90': np.percentile(levels, [10, 50, 90]).tolist(), 'onsets_per_second': len(onset_times(clip, SR)) / (len(clip) / SR)})\n    report['tracks'].append({'title': track['title'], 'track_id': track['track_id'], 'source_url': 'https://pressuresounds.bandcamp.com' + track['title_link'], 'player_metadata_duration_s': track['duration'], 'decoded_duration_s': len(audio) / SR, 'sha256': hashlib.sha256(path.read_bytes()).hexdigest(), 'bytes': path.stat().st_size, 'ffprobe': probe, 'windows': windows})\nreport['reproduction_source'] = pathlib.Path(__file__).read_text()\npathlib.Path('bandcamp-stream-audit.json').write_text(json.dumps(report, ensure_ascii=False, indent=2) + '\\n')\nprint(json.dumps({t['title']: {'duration': t['decoded_duration_s'], 'windows': len(t['windows']), 'sha256': t['sha256']} for t in report['tracks']}, indent=2))\n"
}
