  "reproduction_source": "\"\"\"Exploratory local waveform matching; no musical-event attribution.\"\"\"\nimport hashlib, json, pathlib\nimport numpy as np\nfrom scipy.signal import butter, sosfiltfilt, resample_poly, correlate\nfrom analyze_previews import decode\nfrom calibrate_analyzer import SR, rms_dbfs\n\nRATE=2000\npaths=[pathlib.Path('386584386.mp3'),pathlib.Path('4115294261.mp3')]\nprior=json.loads(pathlib.Path('bandcamp-stream-audit.json').read_text())\nfor p,t in zip(paths,prior['tracks']):\n    assert hashlib.sha256(p.read_bytes()).hexdigest()==t['sha256']\naudio=[decode(p) for p in paths]\nfiltered=[sosfiltfilt(butter(3,[45,900],btype='bandpass',fs=RATE,output='sos'),resample_poly(a.mean(axis=1),20,441)) for a in audio]\nx,y=filtered\n\ndef match(t,reverse=False):\n    best=None\n    lo=max(0,t-20); hi=min(len(y)/RATE,t+30)\n    region=y[round(lo*RATE):round(hi*RATE)]\n    for scale in np.arange(.98,1.02001,.0005):\n        u=np.arange(round(8*scale*RATE))/RATE\n        template=np.interp((t+u/scale)*RATE,np.arange(len(x)),x)\n        if reverse: template=template[::-1]\n        n=len(template)\n        sums=np.r_[0.,np.cumsum(region)]\n        sq=np.r_[0.,np.cumsum(region*region)]\n        energy=sq[n:]-sq[:-n]-(sums[n:]-sums[:-n])**2/n\n        template=template-template.mean()\n        scores=correlate(region,template,mode='valid',method='fft')/np.sqrt(np.maximum(energy*np.dot(template,template),1e-30))\n        k=int(np.argmax(np.abs(scores)))\n        row={'original_start_s':t,'version_start_s':lo+k/RATE,'scale':float(scale),'correlation':float(scores[k])}\n        if best is None or abs(row['correlation'])>abs(best['correlation']): best=row\n    return best\n\ntrain=[match(t) for t in range(20,181,20)]\ncontrols=[match(t,True) for t in (40,100,160)]\nfit=np.polyfit([r['original_start_s'] for r in train],[r['version_start_s'] for r in train],1)\nfor r in train:r['affine_residual_s']=r['version_start_s']-float(np.polyval(fit,r['original_start_s']))\nvalidation=[match(t) for t in (30,70,110,150,190)]\nfor r in validation:r['affine_residual_s']=r['version_start_s']-float(np.polyval(fit,r['original_start_s']))\nreport={'date':'2026-09-08','input_sha256':[t['sha256'] for t in prior['tracks']], 'method':{'signal':'all-mix stereo mean, resampled 2kHz, order-3 zero-phase Butterworth 45–900Hz','window_original_seconds':8,'search_version_start_radius_seconds':20,'scale_grid':[.98,1.02,.0005],'score':'signed normalized zero-mean waveform correlation; maximize absolute value','equation':'version_time = scale * original_time + offset','control':'same template reversed in time, identical search; only three controls'},'fit':{'scale':float(fit[0]),'offset_s':float(fit[1])},'training':train,'validation':validation,'reversed_controls':controls,'limits':['All-mix filtered waveform, not separated drums.','Exploratory matching, not a calibrated same-recording classifier.','Reversed controls do not establish a population false-positive rate.','No listening, source identification, or CUT/THROW event inference.']}\nreport['matched_levels']=[]\nfor r in sorted(train+validation,key=lambda r:r['original_start_s']):\n    start=r['original_start_s']; vstart=r['version_start_s']; scale=r['scale']\n    # Boundaries follow each independently matched local affine map.\n    a=audio[0][round(start*SR):round((start+8)*SR)]\n    b=audio[1][round(vstart*SR):round((vstart+8*scale)*SR)]\n    levels={}\n    for name,band in [('full',None),('45_180_Hz',[45,180]),('180_900_Hz',[180,900]),('900_8000_Hz',[900,8000])]:\n        clips=[a,b]\n        if band:\n            sos=butter(3,band,btype='bandpass',fs=SR,output='sos')\n            clips=[sosfiltfilt(sos,c,axis=0) for c in clips]\n        # Discard 0.1 seconds at each end to reduce filter boundary effects.\n        values=[rms_dbfs(c[4410:-4410]) for c in clips]\n        levels[name]={'original_dbfs':values[0],'version_dbfs':values[1],'delta_db':values[1]-values[0]}\n    report['matched_levels'].append({'original_start_s':start,'version_start_s':vstart,'levels':levels})\nreport['level_method']='Order-3 zero-phase bandpass at 44100 Hz; shared rms_dbfs; matched 8s local intervals; trim 0.1s at each end. No loudness normalization.'\nreport['level_summary']={name:{'median_delta_db':float(np.median([r['levels'][name]['delta_db'] for r in report['matched_levels']])),'negative_windows':sum(r['levels'][name]['delta_db']<0 for r in report['matched_levels']),'windows':14} for name in ['full','45_180_Hz','180_900_Hz','900_8000_Hz']}\nreport['limits']+=['Frequency bands are not instrument stems; bass-band energy does not identify bass guitar.','Fourteen selected 8s windows do not cover the whole track.','End trimming reduces but does not eliminate filtering boundary effects.']\nsaved_x,saved_y=x,y\nrng=np.random.default_rng(20260908)\nx=sosfiltfilt(butter(3,[45,900],btype='bandpass',fs=RATE,output='sos'),rng.normal(size=60*RATE))\nknown_scale,known_offset=1.005,0.37\ny=np.interp((np.arange(60*RATE)/RATE-known_offset)/known_scale*RATE,np.arange(len(x)),x,left=0,right=0)\ncheck=match(20)\ncheck['expected_version_start_s']=20*known_scale+known_offset\ncheck['expected_scale']=known_scale\ncheck['passed']=bool(abs(check['version_start_s']-check['expected_version_start_s'])<=1/RATE and abs(check['scale']-known_scale)<.00001)\nassert check['passed'],check\nx,y=saved_x,saved_y\nreport['synthetic_alignment_check']=check\nreport['reproduction_source']=pathlib.Path(__file__).read_text()\npathlib.Path('bandcamp-alignment-audit.json').write_text(json.dumps(report,ensure_ascii=False,indent=2)+'\\n')\nprint(json.dumps({'fit':report['fit'],'level_summary':report['level_summary']},indent=2))\n"
}
